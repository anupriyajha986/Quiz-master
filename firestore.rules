rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =========================================================================
    // HELPER FUNCTIONS & ROLE RESOLUTION
    // =========================================================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (
        ('role' in request.auth.token && request.auth.token.role == 'super_admin') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperAdmin() ||
        ('role' in request.auth.token && request.auth.token.role in ['admin', 'super_admin', 'manager', 'evaluator']) ||
        ('admin' in request.auth.token && request.auth.token.admin == true) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'super_admin', 'manager', 'evaluator'])
      );
    }

    // =========================================================================
    // 1. USERS COLLECTION (/users/{uid})
    // =========================================================================
    match /users/{uid} {
      // User reads own profile; Admins read profiles according to management scope
      allow get: if isUser(uid) || isAdmin();
      allow list: if isAdmin();

      // Registration: Student creates own record; Admin provisions student; Super Admin manages all
      allow create: if isAuthenticated() && (
        (isUser(uid) && 
         request.resource.data.role == 'student' && 
         !('permissions' in request.resource.data) && 
         !('isSuperAdmin' in request.resource.data) && 
         !('admin' in request.resource.data)) ||
        (isAdmin() && request.resource.data.role == 'student') ||
        isSuperAdmin()
      );

      // Updates: Strict field restrictions & demotion/privilege escalation prevention
      allow update: if isAuthenticated() && (
        // Super Admin can manage accounts, but cannot be demoted or altered by ordinary admins
        (isSuperAdmin() && (resource.data.role != 'super_admin' || isUser(uid) || request.resource.data.role == 'super_admin')) ||
        // Student self-service: only non-privileged profile fields allowed
        (isUser(uid) &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.accountStatus == resource.data.accountStatus &&
          (!('permissions' in request.resource.data) || request.resource.data.permissions == resource.data.permissions) &&
          (!('isSuperAdmin' in request.resource.data) || request.resource.data.isSuperAdmin == resource.data.isSuperAdmin) &&
          (!('admin' in request.resource.data) || request.resource.data.admin == resource.data.admin)
        ) ||
        // Ordinary Admin: can manage student accounts, cannot promote to staff or modify staff
        (isAdmin() &&
          resource.data.role == 'student' &&
          request.resource.data.role == 'student' &&
          !('permissions' in request.resource.data)
        )
      );

      // Deletion: Super Admin can delete; Admin can only delete students
      allow delete: if isAuthenticated() && (
        (isSuperAdmin() && resource.data.role != 'super_admin') ||
        (isAdmin() && resource.data.role == 'student')
      );
    }

    // =========================================================================
    // 2. ACADEMIC SUBJECTS (/subjects/{subjectId})
    // =========================================================================
    match /subjects/{subjectId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 3. QUESTION BANK (/questions/{questionId})
    // =========================================================================
    match /questions/{questionId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 4. ANSWER KEYS VAULT (/answerKeys/{testId})
    // =========================================================================
    match /answerKeys/{testId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 5. QUESTION SETS (/questionSets/{setId})
    // =========================================================================
    match /questionSets/{setId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // 6. EXAMINATIONS (/tests/{testId})
    // =========================================================================
    match /tests/{testId} {
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (resource.data.publicationStatus in ['published', 'scheduled'] &&
         (!('status' in resource.data) || (resource.data.status != 'archived' && resource.data.status != 'disabled')))
      );
      allow write: if isAdmin();
    }

    // =========================================================================
    // 7. ATTEMPTS & RESPONSES (/attempts/{attemptId})
    // =========================================================================
    match /attempts/{attemptId} {
      allow get: if isAuthenticated() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      allow list: if isAuthenticated() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      
      // Creating an attempt: Student creates own attempt on a published test
      allow create: if isAuthenticated() && 
        request.resource.data.studentUid == request.auth.uid &&
        (isAdmin() || (
          exists(/databases/$(database)/documents/tests/$(request.resource.data.testId)) &&
          get(/databases/$(database)/documents/tests/$(request.resource.data.testId)).data.publicationStatus in ['published', 'scheduled']
        )) &&
        (isAdmin() || (!('resultId' in request.resource.data) && !('totalScore' in request.resource.data)));

      // Updating an attempt: Strict immutability for server-controlled fields & single-direction lifecycle
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.studentUid == request.auth.uid && 
          resource.data.status == 'in_progress' &&
          request.resource.data.studentUid == resource.data.studentUid &&
          request.resource.data.testId == resource.data.testId &&
          request.resource.data.startedAt == resource.data.startedAt &&
          request.resource.data.deadlineAt == resource.data.deadlineAt &&
          (!('durationMinutes' in resource.data) || request.resource.data.durationMinutes == resource.data.durationMinutes) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'submittedAt', 'lastActivityAt', 'candidateNotes', 'responseSummary', 'updatedAt']) &&
          request.resource.data.status in ['in_progress', 'submitted'] &&
          (!('resultId' in request.resource.data) || request.resource.data.resultId == resource.data.resultId) &&
          !('totalScore' in request.resource.data) &&
          !('score' in request.resource.data) &&
          !('evaluationStatus' in request.resource.data)
        )
      );

      allow delete: if isAdmin();

      // Responses subcollection inside attempts
      match /responses/{questionId} {
        allow read: if isAuthenticated() && (
          isAdmin() ||
          get(/databases/$(database)/documents/attempts/$(attemptId)).data.studentUid == request.auth.uid
        );

        allow write: if isAuthenticated() && (
          isAdmin() || (
            get(/databases/$(database)/documents/attempts/$(attemptId)).data.studentUid == request.auth.uid &&
            get(/databases/$(database)/documents/attempts/$(attemptId)).data.status == 'in_progress' &&
            request.resource.data.questionId == questionId &&
            !('isCorrect' in request.resource.data) &&
            !('marksAwarded' in request.resource.data) &&
            !('score' in request.resource.data)
          )
        );
      }
    }

    // =========================================================================
    // 8. RESULTS COLLECTION (/results/{resultId})
    // =========================================================================
    match /results/{resultId} {
      allow get: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.studentUid == request.auth.uid && resource.data.publicationStatus == 'published')
      );
      allow list: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.studentUid == request.auth.uid && resource.data.publicationStatus == 'published')
      );
      allow create, update, delete: if isAdmin();
    }

    // =========================================================================
    // 9. NOTIFICATIONS (/notifications/{notificationId})
    // =========================================================================
    match /notifications/{notificationId} {
      allow get, list: if isAuthenticated() && (
        resource.data.recipientUid == 'all' ||
        resource.data.recipientUid == request.auth.uid ||
        isAdmin()
      );

      // Student can only self-notify; cannot broadcast to 'all' or spoof recipient
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.recipientUid == request.auth.uid && request.resource.data.recipientUid != 'all')
      );

      // Student can only update read status of their own notifications
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.recipientUid == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isRead', 'readAt', 'updatedAt'])
        )
      );

      allow delete: if isAdmin();
    }

    // =========================================================================
    // 10. BOOKMARKS (/bookmarks/{bookmarkId})
    // =========================================================================
    match /bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && (isAdmin() || resource.data.studentUid == request.auth.uid);
      allow create: if isAuthenticated() && 
        request.resource.data.studentUid == request.auth.uid &&
        !('isPrivileged' in request.resource.data);
      allow update: if isAuthenticated() && (
        isAdmin() || (
          resource.data.studentUid == request.auth.uid &&
          request.resource.data.studentUid == resource.data.studentUid
        )
      );
      allow delete: if isAuthenticated() && (isAdmin() || resource.data.studentUid == request.auth.uid);
    }

    // =========================================================================
    // 11. AUDIT LOGS (/auditLogs/{logId})
    // =========================================================================
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      // Actor cannot be spoofed to another user
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (request.resource.data.actorUid == request.auth.uid)
      );
      // Immutable log
      allow update, delete: if false;
    }

    // =========================================================================
    // 12. PLATFORM SETTINGS (/platformSettings/{settingId})
    // =========================================================================
    match /platformSettings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
